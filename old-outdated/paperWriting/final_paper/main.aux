\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Ensemble Performance}{35}{subsection.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.3.1}Ensemble Strategy and Results}{35}{subsubsection.4.3.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Single Model vs. Ensemble Performance on the 251-Patient Held-Out Set}}{36}{table.4}\protected@file@percent }
\newlabel{tab:ensemble}{{4}{36}{Single Model vs. Ensemble Performance on the 251-Patient Held-Out Set}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Individual Fold Models vs.\ 5-Fold Soft-Voting Ensemble — Per-Metric Comparison.} Blue bars show the mean across 5 individual fold models; pink bars show the 5-model soft-voting ensemble evaluated on the sealed 251-patient held-out set. The ensemble achieves $+1.39\%$ absolute Dice improvement (90.02\%\,$\rightarrow $\,91.41\%), confirmed as statistically significant by one-sample $t$-test ($t=-4.19$, $p=0.014$, 95\% CI $[89.10\%,90.94\%]$, $df=4$). Sensitivity, Specificity, and Precision improvements are consistent with variance reduction through soft-voting aggregation.}}{36}{figure.3}\protected@file@percent }
\newlabel{fig:ensemble_lift}{{3}{36}{\textbf {Individual Fold Models vs.\ 5-Fold Soft-Voting Ensemble — Per-Metric Comparison.} Blue bars show the mean across 5 individual fold models; pink bars show the 5-model soft-voting ensemble evaluated on the sealed 251-patient held-out set. The ensemble achieves $+1.39\%$ absolute Dice improvement (90.02\%\,$\rightarrow $\,91.41\%), confirmed as statistically significant by one-sample $t$-test ($t=-4.19$, $p=0.014$, 95\% CI $[89.10\%,90.94\%]$, $df=4$). Sensitivity, Specificity, and Precision improvements are consistent with variance reduction through soft-voting aggregation}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Efficiency Benchmarking}{37}{subsection.4.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.4.1}Baseline Comparison}{37}{subsubsection.4.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Efficiency Comparison: GraphSAGE (Ours) vs. 3D U-Net Baseline}}{39}{table.5}\protected@file@percent }
\newlabel{tab:efficiency}{{5}{39}{Efficiency Comparison: GraphSAGE (Ours) vs. 3D U-Net Baseline}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Computational Efficiency: GNN vs.\ 3D U-Net Baseline.} All measurements on NVIDIA RTX 2060, 6\,GB VRAM. \textit  {Left:} End-to-end inference time per patient. GNN end-to-end (1.47\,s including SLIC) is 6.9$\times $ faster than U-Net (10.16\,s); GNN with pre-built graph (74\,ms) is $>$137$\times $ faster. \textit  {Centre:} Peak GPU memory during inference (log scale). GNN requires 11\,MB vs.\ 2{,}500\,MB for U-Net — a 227$\times $ reduction enabling deployment on 6\,GB VRAM consumer hardware. \textit  {Right:} Model parameter count (log scale). 439K vs.\ 68M — 155$\times $ fewer parameters, allowing edge and mobile deployment.}}{40}{figure.4}\protected@file@percent }
\newlabel{fig:speed_memory}{{4}{40}{\textbf {Computational Efficiency: GNN vs.\ 3D U-Net Baseline.} All measurements on NVIDIA RTX 2060, 6\,GB VRAM. \textit {Left:} End-to-end inference time per patient. GNN end-to-end (1.47\,s including SLIC) is 6.9$\times $ faster than U-Net (10.16\,s); GNN with pre-built graph (74\,ms) is $>$137$\times $ faster. \textit {Centre:} Peak GPU memory during inference (log scale). GNN requires 11\,MB vs.\ 2{,}500\,MB for U-Net — a 227$\times $ reduction enabling deployment on 6\,GB VRAM consumer hardware. \textit {Right:} Model parameter count (log scale). 439K vs.\ 68M — 155$\times $ fewer parameters, allowing edge and mobile deployment}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Accuracy vs.\ Efficiency Trade-off.} Each point represents a model; bubble area is proportional to $\sqrt  {\text  {parameters}}$ for readability. The GNN single model (439K, 1.47\,s, 90.02\% Dice) and ensemble (2.2M, 1.47\,s, 91.41\%) both appear in the upper-left (fast and accurate) compared to the 3D U-Net (68M, 10.16\,s, 87.5\%). The dashed green line marks the 90\% clinical target threshold. All measurements on identical RTX 2060\,/\,6\,GB VRAM hardware.}}{40}{figure.5}\protected@file@percent }
\newlabel{fig:efficiency_bubble}{{5}{40}{\textbf {Accuracy vs.\ Efficiency Trade-off.} Each point represents a model; bubble area is proportional to $\sqrt {\text {parameters}}$ for readability. The GNN single model (439K, 1.47\,s, 90.02\% Dice) and ensemble (2.2M, 1.47\,s, 91.41\%) both appear in the upper-left (fast and accurate) compared to the 3D U-Net (68M, 10.16\,s, 87.5\%). The dashed green line marks the 90\% clinical target threshold. All measurements on identical RTX 2060\,/\,6\,GB VRAM hardware}{figure.5}{}}
