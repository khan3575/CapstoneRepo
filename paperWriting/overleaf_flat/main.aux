\newlabel{tab:efficiency}{{5}{43}{Efficiency Comparison: GraphSAGE (Ours) vs. 3D U-Net Baseline}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Computational Efficiency: GNN vs.\ 3D U-Net Baseline.} All measurements on NVIDIA RTX 2060, 6\,GB VRAM. \textit  {Left:} End-to-end inference time per patient. GNN end-to-end (1.47\,s including SLIC) is 6.9$\times $ faster than U-Net (10.16\,s) — the valid apples-to-apples comparison. GNN forward-pass with pre-built graph is 74\,ms (ceiling; see Table~\ref {tab:efficiency} footnote). \textit  {Centre:} Peak GPU memory during inference (log scale). GNN requires 11\,MB vs.\ 2{,}500\,MB for U-Net — a 227$\times $ reduction enabling deployment on 6\,GB VRAM consumer hardware. \textit  {Right:} Model parameter count (log scale). 439K vs.\ 68M — 155$\times $ fewer parameters, allowing edge and mobile deployment.}}{44}{figure.4}\protected@file@percent }
\newlabel{fig:speed_memory}{{4}{44}{\textbf {Computational Efficiency: GNN vs.\ 3D U-Net Baseline.} All measurements on NVIDIA RTX 2060, 6\,GB VRAM. \textit {Left:} End-to-end inference time per patient. GNN end-to-end (1.47\,s including SLIC) is 6.9$\times $ faster than U-Net (10.16\,s) — the valid apples-to-apples comparison. GNN forward-pass with pre-built graph is 74\,ms (ceiling; see Table~\ref {tab:efficiency} footnote). \textit {Centre:} Peak GPU memory during inference (log scale). GNN requires 11\,MB vs.\ 2{,}500\,MB for U-Net — a 227$\times $ reduction enabling deployment on 6\,GB VRAM consumer hardware. \textit {Right:} Model parameter count (log scale). 439K vs.\ 68M — 155$\times $ fewer parameters, allowing edge and mobile deployment}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Accuracy vs.\ Efficiency Trade-off.} Each point represents a model; bubble area is proportional to $\sqrt  {\text  {parameters}}$ for visual readability (square-root scaling compresses the 155$\times $ parameter range to fit in a single plot; actual parameter ratios are as labelled). The GNN single model (439K, 1.47\,s, 90.02\% Dice) and ensemble (2.2M, 1.47\,s, 91.41\%) both appear in the upper-left (fast and accurate) compared to the 3D U-Net (68M, 10.16\,s, 87.5\%). The dashed green line marks the 90\% clinical target threshold. All measurements on identical RTX 2060\,/\,6\,GB VRAM hardware.}}{45}{figure.5}\protected@file@percent }
\newlabel{fig:efficiency_bubble}{{5}{45}{\textbf {Accuracy vs.\ Efficiency Trade-off.} Each point represents a model; bubble area is proportional to $\sqrt {\text {parameters}}$ for visual readability (square-root scaling compresses the 155$\times $ parameter range to fit in a single plot; actual parameter ratios are as labelled). The GNN single model (439K, 1.47\,s, 90.02\% Dice) and ensemble (2.2M, 1.47\,s, 91.41\%) both appear in the upper-left (fast and accurate) compared to the 3D U-Net (68M, 10.16\,s, 87.5\%). The dashed green line marks the 90\% clinical target threshold. All measurements on identical RTX 2060\,/\,6\,GB VRAM hardware}{figure.5}{}}
