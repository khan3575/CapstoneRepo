\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Cross-Edition Generalisation: BraTS 2021 vs.\ BraTS 2023.} \textit  {Left}: Grouped bar chart for all five metrics. \textit  {Right}: Per-metric gap (BraTS 2021 $-$ BraTS 2023). Dice drops by 2.01\,pp; sensitivity \textit  {improves} by $+$2.92\,pp, indicating tumour recall is preserved. Precision drops 3.06\,pp, consistent with a slightly higher false-positive rate on BraTS 2023 scanner diversity.}}{44}{figure.6}\protected@file@percent }
\newlabel{fig:generalisation}{{6}{44}{\textbf {Cross-Edition Generalisation: BraTS 2021 vs.\ BraTS 2023.} \textit {Left}: Grouped bar chart for all five metrics. \textit {Right}: Per-metric gap (BraTS 2021 $-$ BraTS 2023). Dice drops by 2.01\,pp; sensitivity \textit {improves} by $+$2.92\,pp, indicating tumour recall is preserved. Precision drops 3.06\,pp, consistent with a slightly higher false-positive rate on BraTS 2023 scanner diversity}{figure.6}{}}
