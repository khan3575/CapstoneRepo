\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Qualitative Segmentation Results.} Representative examples spanning the full performance range. Each row shows (left to right): T1CE MRI input, ground truth overlay (red), GNN ensemble prediction (blue), and comparison (red~=~GT only, blue~=~prediction only, purple~=~overlap). \textbf  {(a)}~Best case: Dice~=~100\%, perfect agreement. \textbf  {(b)}~Median case: Dice~=~92.3\%, minor boundary disagreement. \textbf  {(c,\,d)}~Worst cases: Dice~$\approx $~0\%, complete-miss failures on patients with absent T1CE enhancement.}}{46}{figure.7}\protected@file@percent }
\newlabel{fig:qualitative}{{7}{46}{\textbf {Qualitative Segmentation Results.} Representative examples spanning the full performance range. Each row shows (left to right): T1CE MRI input, ground truth overlay (red), GNN ensemble prediction (blue), and comparison (red~=~GT only, blue~=~prediction only, purple~=~overlap). \textbf {(a)}~Best case: Dice~=~100\%, perfect agreement. \textbf {(b)}~Median case: Dice~=~92.3\%, minor boundary disagreement. \textbf {(c,\,d)}~Worst cases: Dice~$\approx $~0\%, complete-miss failures on patients with absent T1CE enhancement}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Per-Graph Dice Distribution --- BraTS 2021 Held-Out (251 patients).} \textit  {Left}: Per-graph Dice histogram; red bins (Dice $<$ 0.10) are complete-miss slices (5.0\% of graphs); dominant high-quality peak (Dice $\geq $ 0.90: 81.2\%). Dashed line: per-slice mean (83.2\%); dash-dot line: patient-level ensemble Dice (91.41\%). \textit  {Right}: Quality tier breakdown pie chart.}}{47}{figure.8}\protected@file@percent }
\newlabel{fig:dice_hist}{{8}{47}{\textbf {Per-Graph Dice Distribution --- BraTS 2021 Held-Out (251 patients).} \textit {Left}: Per-graph Dice histogram; red bins (Dice $<$ 0.10) are complete-miss slices (5.0\% of graphs); dominant high-quality peak (Dice $\geq $ 0.90: 81.2\%). Dashed line: per-slice mean (83.2\%); dash-dot line: patient-level ensemble Dice (91.41\%). \textit {Right}: Quality tier breakdown pie chart}{figure.8}{}}
