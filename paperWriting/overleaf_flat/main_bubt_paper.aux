\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Accuracy vs.\ Efficiency Trade-off.} Bubble area $\propto \sqrt  {\text  {parameters}}$. GNN single model (439K, 1.73\,s, 90.02\%) and ensemble (2.2M, 1.73\,s, 91.41\%) both occupy the upper-left region (accurate and fast); 3D U-Net (69.1M, 10.16\,s, 87.84\%) occupies the lower-right. Dashed line: 90\% Dice clinical target.}}{41}{figure.3}\protected@file@percent }
\newlabel{fig:bubble}{{3}{41}{\textbf {Accuracy vs.\ Efficiency Trade-off.} Bubble area $\propto \sqrt {\text {parameters}}$. GNN single model (439K, 1.73\,s, 90.02\%) and ensemble (2.2M, 1.73\,s, 91.41\%) both occupy the upper-left region (accurate and fast); 3D U-Net (69.1M, 10.16\,s, 87.84\%) occupies the lower-right. Dashed line: 90\% Dice clinical target}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Computational Efficiency: GNN vs.\ 3D U-Net.} \textit  {Left}: End-to-end inference time; GNN (1.73\,s) is 5.9$\times $ faster than U-Net (10.16\,s). GNN forward pass with pre-built graph: 75.4\,ms. \textit  {Centre}: Peak GPU memory (log scale); 11\,MB vs.\ 2,500\,MB --- 227$\times $ reduction. \textit  {Right}: Parameters (log scale); 439K vs.\ 69.1M --- 157$\times $ fewer. All measurements on RTX 2060, 6\,GB VRAM.}}{41}{figure.4}\protected@file@percent }
\newlabel{fig:efficiency}{{4}{41}{\textbf {Computational Efficiency: GNN vs.\ 3D U-Net.} \textit {Left}: End-to-end inference time; GNN (1.73\,s) is 5.9$\times $ faster than U-Net (10.16\,s). GNN forward pass with pre-built graph: 75.4\,ms. \textit {Centre}: Peak GPU memory (log scale); 11\,MB vs.\ 2,500\,MB --- 227$\times $ reduction. \textit {Right}: Parameters (log scale); 439K vs.\ 69.1M --- 157$\times $ fewer. All measurements on RTX 2060, 6\,GB VRAM}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Ablation Study: Architecture Variants (Fold 0, Single-Fold Protocol)}}{42}{table.8}\protected@file@percent }
\newlabel{tab:ablation}{{8}{42}{Ablation Study: Architecture Variants (Fold 0, Single-Fold Protocol)}{table.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Ablation Study (Fold 0 Protocol).} Solid bars: Test Dice (\%); hatched bars: parameter count (K). $^\star $~indicates 30-epoch training (vs.\ 50 for baseline/6L variants). All values are below the 5-fold CV results --- only relative rankings apply. Deeper (6L): $-$0.03\,pp with 30\% more parameters. Wider (512-dim): $+$4.75\,pp at 3.9$\times $ cost; promising but trained with fewer epochs (further investigation deferred to future work). GAT: $+$1.00\,pp at 2.7$\times $ cost. The 256-dim baseline is selected for maximum parameter efficiency.}}{42}{figure.5}\protected@file@percent }
\newlabel{fig:ablation}{{5}{42}{\textbf {Ablation Study (Fold 0 Protocol).} Solid bars: Test Dice (\%); hatched bars: parameter count (K). $^\star $~indicates 30-epoch training (vs.\ 50 for baseline/6L variants). All values are below the 5-fold CV results --- only relative rankings apply. Deeper (6L): $-$0.03\,pp with 30\% more parameters. Wider (512-dim): $+$4.75\,pp at 3.9$\times $ cost; promising but trained with fewer epochs (further investigation deferred to future work). GAT: $+$1.00\,pp at 2.7$\times $ cost. The 256-dim baseline is selected for maximum parameter efficiency}{figure.5}{}}
